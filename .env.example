# Copie ce fichier vers .env.local et remplis les valeurs.
# Tableau de bord Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origine publique de l'app (liens email confirmation/reset). Ex : https://look360.io
NEXT_PUBLIC_SITE_URL=

# Emails transactionnels (Resend) — optionnel, branchement préparé.
# NE JAMAIS committer la vraie clé : la mettre dans Vercel/serveur uniquement.
RESEND_API_KEY=
EMAIL_FROM=Look360 <no-reply@look360.io>

# ---------------------------------------------------------------------------
# PHASE 3 — Paiement (GeniusPay). NB : l'app Next N'A PAS besoin de ces secrets.
# Ils vivent UNIQUEMENT dans les secrets des Edge Functions Supabase (voir
# docs/PHASE3_PAIEMENT.md). Le paiement est initié côté Edge Function : aucune
# clé prestataire n'est exposée au navigateur ni requise dans Vercel.
#
# À définir dans Supabase → Edge Functions → Secrets (noms uniquement ici) :
#   GENIUSPAY_ENV=sandbox            # puis "live" quand validé (simple label)
#   GENIUSPAY_API_KEY                # en-tête X-API-Key
#   GENIUSPAY_API_SECRET             # en-tête X-API-Secret
#   GENIUSPAY_WEBHOOK_SECRET         # HMAC du webhook
#   SITE_URL=https://look360.io      # liens des emails de relance
#   CRON_SECRET                      # protège la fonction de relances
#   RESEND_API_KEY / EMAIL_FROM      # relances email (réutilise les mêmes)
#   GENIUSPAY_API_URL    (optionnel) # défaut https://geniuspay.ci/api/v1/merchant/payments
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont injectés
# automatiquement dans les Edge Functions (ne pas les recréer).
# ---------------------------------------------------------------------------
