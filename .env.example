# Copie ce fichier vers .env.local et remplis les valeurs.
# Tableau de bord Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origine publique de l'app (liens email confirmation/reset). Ex : https://look360.io
NEXT_PUBLIC_SITE_URL=

# Emails transactionnels (Resend) — optionnel, branchement préparé.
# NE JAMAIS committer la vraie clé : la mettre dans Vercel/serveur uniquement.
RESEND_API_KEY=
EMAIL_FROM=Look360 <no-reply@look360.io>
